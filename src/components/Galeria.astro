---
import { trabalhos, categorias } from '../data/negocio.js';
import { url } from '../utils/url.js';

const total = String(trabalhos.length).padStart(2, '0');
const label = (id: string) => categorias.find((c) => c.id === id)?.label ?? id;
---

<section class="galeria" id="trabalhos">
  <div class="container">
    <div class="galeria__head">
      <div class="section-head">
        <p class="eyebrow">Trabalhos</p>
        <h2>O que sai daqui.</h2>
        <p>
          Peças autorais em preto e cinza, fine line e blackwork. Clique em
          qualquer uma para ver de perto.
        </p>
      </div>

      <div class="galeria__meta">
        <span class="galeria__contador"><span data-contador>{total}</span> peças</span>
      </div>
    </div>

    <div class="filtros" role="group" aria-label="Filtrar trabalhos por estilo">
      <button class="filtro" type="button" data-filtro="todos" aria-pressed="true">
        Todos
      </button>
      {categorias.map((c) => (
        <button class="filtro" type="button" data-filtro={c.id} aria-pressed="false">
          {c.label}
        </button>
      ))}
    </div>

    <div class="masonry">
      {trabalhos.map((t) => (
        <button
          class="trabalho"
          type="button"
          data-id={t.id}
          data-categoria={t.categoria}
          data-src={url(t.arquivo)}
          data-titulo={t.titulo}
          data-local={t.local}
          data-estilo={label(t.categoria)}
          aria-label={`Abrir ${t.titulo}, ${t.local}`}
        >
          <img
            src={url(t.arquivo)}
            alt={t.alt}
            width={t.largura}
            height={t.altura}
            loading="lazy"
          />
          <span class="trabalho__info">
            <span class="trabalho__titulo">{t.titulo}</span>
            <span class="trabalho__local">
              {label(t.categoria)} · {t.local}
            </span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const filtros = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const pecas = document.querySelectorAll<HTMLElement>('.trabalho');
  const contador = document.querySelector<HTMLElement>('[data-contador]');

  filtros.forEach((botao) => {
    botao.addEventListener('click', () => {
      const alvo = botao.dataset.filtro;
      filtros.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));

      let visiveis = 0;
      pecas.forEach((peca) => {
        const mostrar = alvo === 'todos' || peca.dataset.categoria === alvo;
        peca.hidden = !mostrar;
        if (mostrar) visiveis++;
      });

      if (contador) contador.textContent = String(visiveis).padStart(2, '0');
    });
  });

  pecas.forEach((peca) => {
    peca.addEventListener('click', () => {
      document.dispatchEvent(
        new CustomEvent('carvao:abrir', { detail: { id: peca.dataset.id } })
      );
    });
  });
</script>

<style>
  .galeria {
    padding-block: var(--section-y);
    background: var(--tinta);
  }

  .galeria__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .galeria__meta {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .galeria__contador {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--osso-fraco);
    white-space: nowrap;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--linha);
  }

  .filtro {
    padding: 0.55rem 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--osso-suave);
    border: 1px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  .filtro:hover {
    color: var(--osso);
  }

  .filtro[aria-pressed='true'] {
    color: var(--osso);
    border-color: var(--linha-forte);
  }

  .filtro[aria-pressed='true']::before {
    content: '•';
    color: var(--acento);
    margin-right: 0.5rem;
  }

  .masonry {
    columns: 3;
    column-gap: 1.25rem;
  }

  .trabalho {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 1.25rem;
    padding: 0;
    break-inside: avoid;
    overflow: hidden;
    text-align: left;
    background: var(--grafite);
  }

  .trabalho img {
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.04);
    transition:
      transform 900ms var(--ease),
      opacity 400ms var(--ease);
  }

  .trabalho:hover img {
    transform: scale(1.035);
  }

  .trabalho__info {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.2rem;
    padding: 2.5rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(10, 9, 8, 0.92), transparent);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 300ms var(--ease),
      transform 300ms var(--ease);
  }

  .trabalho:hover .trabalho__info,
  .trabalho:focus-visible .trabalho__info {
    opacity: 1;
    transform: none;
  }

  .trabalho__titulo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .trabalho__local {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--osso-suave);
  }

  @media (max-width: 900px) {
    .masonry {
      columns: 2;
      column-gap: 1rem;
    }

    .trabalho {
      margin-bottom: 1rem;
    }

    .trabalho__info {
      position: static;
      opacity: 1;
      transform: none;
      background: none;
      padding: 0.7rem 0 0;
    }
  }

  @media (max-width: 560px) {
    .masonry {
      columns: 1;
    }
  }
</style>
