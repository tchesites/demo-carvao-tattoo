---
import { depoimentos } from '../data/negocio.js';
---

<section class="depoimentos">
  <div class="container">
    <div class="depoimentos__head">
      <p class="eyebrow">Na cadeira</p>
      <span class="depoimentos__nota">Depoimentos ilustrativos</span>
    </div>

    <div class="depoimentos__grid">
      {depoimentos.map((d) => (
        <figure class="depoimento reveal">
          <blockquote>
            <p>“{d.texto}”</p>
          </blockquote>
          <figcaption>
            <span class="depoimento__autor">{d.autor}</span>
            <span class="depoimento__detalhe">{d.detalhe}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .depoimentos {
    padding-block: var(--section-y);
    background: var(--grafite);
  }

  .depoimentos__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--linha);
  }

  .depoimentos__nota {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--osso-fraco);
  }

  .depoimentos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .depoimento {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  .depoimento p {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .depoimento figcaption {
    display: grid;
    gap: 0.25rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--linha);
  }

  .depoimento__autor {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .depoimento__detalhe {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--osso-fraco);
  }

  @media (max-width: 900px) {
    .depoimentos__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
