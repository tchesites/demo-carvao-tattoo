---
import { cuidados } from '../data/negocio.js';
---

<section class="cuidados" id="cuidados">
  <div class="container cuidados__grid">
    <div class="cuidados__intro">
      <p class="eyebrow">Cuidados</p>
      <h2>O que fazer depois que a agulha para.</h2>
      <p>
        Cicatrização é metade do trabalho. Estas são as orientações que eu passo
        em toda sessão — e que fazem diferença no resultado daqui a cinco anos.
      </p>
    </div>

    <div class="acordeao">
      {cuidados.map((c, i) => (
        <details class="item" open={i === 0}>
          <summary>
            <span>{c.titulo}</span>
            <span class="item__sinal" aria-hidden="true"></span>
          </summary>
          <p>{c.texto}</p>
        </details>
      ))}
      <p class="cuidados__aviso">
        Orientações gerais. Siga sempre o protocolo do seu tatuador e procure um
        médico se notar febre, dor forte ou sinal de infecção.
      </p>
    </div>
  </div>
</section>

<style>
  .cuidados {
    padding-block: var(--section-y);
    background: var(--tinta);
  }

  .cuidados__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .cuidados__intro {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .cuidados__intro h2 {
    font-size: var(--display-2);
    margin-top: 1.2rem;
    max-width: 16ch;
  }

  .cuidados__intro > p:last-child {
    margin-top: 1.4rem;
    max-width: 38ch;
    color: var(--osso-suave);
  }

  .item {
    border-top: 1px solid var(--linha);
  }

  .item:last-of-type {
    border-bottom: 1px solid var(--linha);
  }

  .item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .item summary::-webkit-details-marker {
    display: none;
  }

  .item__sinal {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
  }

  .item__sinal::before,
  .item__sinal::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--osso-suave);
    transition: transform var(--transition);
  }

  .item__sinal::after {
    transform: rotate(90deg);
  }

  .item[open] .item__sinal::after {
    transform: rotate(0deg);
  }

  .item[open] summary {
    color: var(--osso);
  }

  .item p {
    padding: 0 2.5rem 1.5rem 0;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--osso-suave);
  }

  .cuidados__aviso {
    margin-top: 1.6rem;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--osso-fraco);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .cuidados__grid {
      grid-template-columns: 1fr;
    }

    .cuidados__intro {
      position: static;
    }
  }
</style>
