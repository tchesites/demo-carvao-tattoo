---
import { negocio, whatsappLink } from '../data/negocio.js';
---

<footer class="footer">
  <div class="container">
    <div class="footer__topo">
      <a class="footer__logo" href="#topo">{negocio.nome}<span aria-hidden="true">.</span></a>
      <p class="footer__assinatura">{negocio.assinatura}</p>
    </div>

    <div class="footer__grid">
      <nav class="footer__nav" aria-label="Rodapé">
        <a href="#trabalhos">Trabalhos</a>
        <a href="#processo">Processo</a>
        <a href="#sobre">Sobre</a>
        <a href="#cuidados">Cuidados</a>
        <a href="#agenda">Agenda</a>
      </nav>

      <div class="footer__col">
        <span class="footer__rotulo">Onde</span>
        <p>{negocio.endereco}</p>
        <p>{negocio.cidade}/{negocio.estado}</p>
      </div>

      <div class="footer__col">
        <span class="footer__rotulo">Contato</span>
        <a href={negocio.instagramUrl} target="_blank" rel="noopener noreferrer">{negocio.instagram}</a>
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">{negocio.telefoneDisplay}</a>
      </div>
    </div>

    <div class="footer__base">
      <p>Projeto demonstrativo — desenvolvido pelo <a href="https://tchesites.com.br" target="_blank" rel="noopener noreferrer">Tchê Sites</a>.</p>
      <p>Marca, endereço, contato e depoimentos são fictícios. Fotos de banco de imagens.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    background: var(--tinta);
    border-top: 1px solid var(--linha);
  }

  .footer__topo {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--linha);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
  }

  .footer__logo span {
    color: var(--acento);
  }

  .footer__assinatura {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--osso-fraco);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 2rem;
    padding-block: 2.2rem;
  }

  .footer__nav {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .footer__nav a {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--osso-suave);
    justify-self: start;
    border-bottom: 1px solid transparent;
  }

  .footer__nav a:hover {
    color: var(--osso);
    border-color: var(--acento);
  }

  .footer__col {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    font-size: 0.9rem;
    color: var(--osso-suave);
  }

  .footer__col a {
    justify-self: start;
    border-bottom: 1px solid transparent;
  }

  .footer__col a:hover {
    color: var(--osso);
    border-color: var(--acento);
  }

  .footer__rotulo {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--osso-fraco);
    margin-bottom: 0.3rem;
  }

  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.4rem;
    border-top: 1px solid var(--linha);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--osso-fraco);
  }

  .footer__base a {
    color: var(--osso-suave);
    border-bottom: 1px solid var(--linha-forte);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__nav {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
