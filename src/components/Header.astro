---
import { negocio } from '../data/negocio.js';
import { whatsappLink } from '../data/negocio.js';

const links = [
  { href: '#trabalhos', label: 'Trabalhos' },
  { href: '#processo', label: 'Processo' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#cuidados', label: 'Cuidados' },
];
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="logo" href="#topo" aria-label="Carvão — início">
      Carvão<span class="logo__dot">.</span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="header__cta" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
      Agendar
    </a>

    <button
      class="burger"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-burger
    >
      <span></span><span></span>
    </button>
  </div>

  <div class="menu" id="menu-mobile" data-menu hidden>
    <nav aria-label="Menu">
      {links.map((l) => <a href={l.href} data-menu-link>{l.label}</a>)}
      <a class="menu__cta" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        Agendar avaliação
      </a>
      <p class="menu__info">{negocio.cidade}/{negocio.estado} · {negocio.instagram}</p>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const fechar = () => {
    if (!menu || !burger) return;
    menu.hidden = true;
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Abrir menu');
    document.body.style.overflow = '';
  };

  burger?.addEventListener('click', () => {
    if (!menu) return;
    const abrir = menu.hidden;
    menu.hidden = !abrir;
    burger.setAttribute('aria-expanded', String(abrir));
    burger.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
    document.body.style.overflow = abrir ? 'hidden' : '';
  });

  menu?.querySelectorAll('[data-menu-link], .menu__cta').forEach((a) => a.addEventListener('click', fechar));
  addEventListener('keydown', (e) => e.key === 'Escape' && fechar());
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .header.is-scrolled {
    background: rgba(10, 9, 8, 0.9);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--linha);
  }

  .header__inner {
    width: min(100% - (var(--gutter) * 2), var(--container));
    margin-inline: auto;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    padding-right: 0.4rem;
  }

  .logo__dot {
    color: var(--acento);
  }

  .nav {
    display: flex;
    gap: 1.8rem;
    margin-left: auto;
  }

  .nav a {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--osso-suave);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  .nav a:hover {
    color: var(--osso);
    border-bottom-color: var(--acento);
  }

  .header__cta {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: 1px solid var(--linha-forte);
    padding: 0.7rem 1.1rem;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .header__cta:hover {
    background: var(--osso);
    color: var(--tinta);
  }

  .burger {
    display: none;
    width: 42px;
    height: 42px;
    margin-left: auto;
    padding: 0;
  }

  .burger span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 6px auto;
    background: var(--osso);
    transition: transform var(--transition);
  }

  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--tinta);
    padding: 3rem var(--gutter);
    overflow-y: auto;
  }

  .menu nav {
    display: grid;
    gap: 0.4rem;
  }

  .menu nav > a {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 9vw, 3.4rem);
    line-height: 1.25;
    border-bottom: 1px solid var(--linha);
    padding-block: 0.5rem;
  }

  .menu__cta {
    margin-top: 2rem;
    border: 1px solid var(--osso);
    padding: 1rem;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .menu__info {
    margin-top: 1.5rem;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--osso-fraco);
  }

  @media (max-width: 900px) {
    .nav,
    .header__cta {
      display: none;
    }

    .burger {
      display: block;
    }
  }
</style>
