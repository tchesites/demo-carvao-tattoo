---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { negocio } from '../data/negocio.js';
import { url } from '../utils/url.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Carvão — Tatuador em Barbacena/MG',
  description = 'Realismo preto e cinza e fine line em Barbacena/MG. Desenho autoral, agenda curta e atendimento direto com o tatuador. Marque sua avaliação.',
} = Astro.props;

const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL(url('/og-image.jpg'), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  name: negocio.nome,
  description:
    'Tatuador solo em Barbacena/MG. Realismo preto e cinza, fine line e blackwork com desenho autoral.',
  url: canonical.href,
  image: ogImage.href,
  telephone: `+55 32 90000-0000`,
  priceRange: '$$',
  currenciesAccepted: 'BRL',
  paymentAccepted: 'Pix, dinheiro, cartão de crédito e débito',
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.endereco,
    addressLocality: negocio.cidade,
    addressRegion: negocio.estado,
    postalCode: negocio.cep,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -21.2259,
    longitude: -43.7747,
  },
  hasMap: negocio.mapsUrl,
  areaServed: {
    '@type': 'City',
    name: 'Barbacena',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '14:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(negocio.notaGoogle),
    reviewCount: String(negocio.totalAvaliacoes),
    bestRating: '5',
    worstRating: '1',
  },
  sameAs: [negocio.instagramUrl],
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `https://wa.me/${negocio.telefoneDigits}`,
      inLanguage: 'pt-BR',
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Tchê Sites" />
    <meta name="theme-color" content="#0a0908" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={negocio.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Carvão — tatuador em Barbacena/MG" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const alvos = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        alvos.forEach((el) => io.observe(el));
      } else {
        alvos.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
